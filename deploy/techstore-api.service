[Unit]
Description=TechStore Product API
After=network.target

[Service]
WorkingDirectory=/home/azureuser/publish
ExecStart=/usr/bin/dotnet /home/azureuser/publish/ProductApi.dll --urls http://0.0.0.0:5000
Restart=always
RestartSec=10
User=azureuser
EnvironmentFile=/etc/techstore-api.env
SyslogIdentifier=techstore-api

[Install]
WantedBy=multi-user.target
